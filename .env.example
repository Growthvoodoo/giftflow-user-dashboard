# Where the GiftFlow app runs — the same URL as SHOPIFY_APP_URL in its .env.
GIFTFLOW_URL=https://your-giftflow-app.example.com

# Created in the GiftFlow admin: Settings → Staff print dashboard → Create key.
GIFTFLOW_API_KEY=gfs_...

# Signs the login cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Port this dashboard listens on.
PORT=4000

# Set to "true" when the dashboard is served over HTTPS (it should be, outside
# a local network), so the login cookie is only ever sent encrypted.
SECURE_COOKIES=false

# How often the order list refreshes itself, in seconds.
REFRESH_SECONDS=60
